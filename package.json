{
	"name": "@atorber/n8n-nodes-x",
	"version": "0.1.2",
	"description": "X node for n8n",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "atorber",
		"email": "atorber@163.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/atorber/n8n-nodes-x.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/GithubIssuesApi.credentials.js",
			"dist/credentials/GithubIssuesOAuth2Api.credentials.js",
			"dist/credentials/ICafeApi.credentials.js",
			"dist/credentials/AihcApi.credentials.js",
			"dist/credentials/ZhiBanApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/GithubIssues/GithubIssues.node.js",
			"dist/nodes/Example/Example.node.js",
			"dist/nodes/iCafe/iCafe.node.js",
			"dist/nodes/Aihc/Aihc.node.js",
			"dist/nodes/ZhiBan/ZhiBan.node.js"
		]
	},
	"dependencies": {
		"@atorber/baiducloud-sdk": "^1.0.3-beta.7"
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
