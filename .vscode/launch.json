{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Build, link and start n8n",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["start"],
			"cwd": "/Users/luyuchao/Documents/GitHub/n8n",
			"preLaunchTask": "build, link and start n8n",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"skipFiles": ["<node_internals>/**"],
			"serverReadyAction": {
				"pattern": "n8n ready on",
				"uriFormat": "http://localhost:5678",
				"action": "openExternally"
			}
		},
		{
			"name": "Link and start n8n",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["link"],
			"cwd": "/Users/luyuchao/Documents/GitHub/n8n",
			"preLaunchTask": "link in n8n custom",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"skipFiles": ["<node_internals>/**"],
			"serverReadyAction": {
				"pattern": "n8n ready on",
				"uriFormat": "http://localhost:5678",
				"action": "openExternally"
			}
		},
		{
			"name": "Attach to running n8n",
			"processId": "${command:PickProcess}",
			"request": "attach",
			"skipFiles": ["<node_internals>/**"],
			"type": "node"
		}
	]
}
